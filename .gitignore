# Not published: too big, proprietary, or specific to one machine.
/src/
/Backup/
/OTA/
/logs/
/.claude/

# Private repo: the proprietary files (kernel/, vendor/, gboard, ayaneo-apps) ARE kept as a backup.
# NEVER make this repository public.

# Third-party binaries (KernelSU Next, Obtainium) are kept too, in case the downloads disappear;
# build.sh still re-downloads them (scripts/fetch-kernelsu.sh, fetch-obtainium.sh).

# Build leftovers
*.idsig
/Customization/apps/*/build/
/Customization/apps/*/*.apk
/swapfile
