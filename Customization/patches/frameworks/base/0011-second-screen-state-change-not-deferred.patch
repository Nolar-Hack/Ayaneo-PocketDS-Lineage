+    /** Whether the on / off state is the only deferrable change, on a display that is not the
+     * default one. */
+    private boolean isSecondaryDisplayStateOnlyUpdate(@Nullable DisplayInfo previous,
+            @NonNull DisplayInfo next) {
+        if (previous == null || mDisplayContent.getDisplayId() == DEFAULT_DISPLAY
+                || previous.state == next.state) {
+            return false;
+        }
+        final DisplayInfo withNewState = new DisplayInfo(previous);
+        withNewState.state = next.state;
+        // The other fields changing along with the state are not deferrable (committedState...)
+        return (calculateDisplayInfoDiff(withNewState, next) & DIFF_WM_DEFERRABLE) == 0;
+    }
