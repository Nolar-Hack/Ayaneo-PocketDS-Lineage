+                        // only one of the console; it needs at least ~30 ms to be felt.
+                        amplitudeCount = addPredefinedEffect(prebaked.getEffectId(), pattern,
+                                amplitudes, amplitudeCount);
+                        continue;
+                    }
                     if (!(segment instanceof StepSegment)) {
                         Slog.w(TAG, "Input devices don't support segment " + segment);
                         amplitudeCount = -1;
