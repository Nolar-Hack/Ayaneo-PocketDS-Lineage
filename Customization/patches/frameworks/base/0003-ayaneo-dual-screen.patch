+    /**
+     * Ayaneo Pocket DS: in the "main screen only" mode the second screen panel is off and its
+     * launcher (AYAHome SECONDARY_HOME) closes itself: that display must not host a home,
+     * which would be relaunched in a loop. The home comes back with the screen.
+     */
+    void onAyaneoDualDisplayModeChanged() {
+        final boolean hidden = AYANEO_DUAL_DISPLAY_MODE_MAIN_ONLY.equals(
+                Settings.Global.getString(mWmService.mContext.getContentResolver(),
+                        AYANEO_DUAL_DISPLAY_MODE_SETTING));
+        synchronized (mService.mGlobalLock) {
+            if (hidden == mAyaneoSecondaryScreenHidden) {
+                return;
+            }
+            mAyaneoSecondaryScreenHidden = hidden;
+            Slog.d(TAG, "Ayaneo second screen hidden=" + hidden);
+            if (hidden) {
+                return;
+            }
+            for (int i = mChildren.size() - 1; i >= 0; --i) {
+                final DisplayContent dc = mChildren.get(i);
+                if (isAyaneoSecondaryScreen(dc)) {
+                    startHomeOnDisplay(mCurrentUser, "ayaneoDualDisplayMode", dc.getDisplayId());
+                }
+            }
+        }
+    }
