+    /**
+     * Ayaneo Pocket DS "bottom screen only" mode (see {@link AyaneoDualScreenController}): the
+     * bottom panel becomes the default display and the other built-in panel is disabled.
+     */
+    void setAyaneoSecondaryOnlyLocked(boolean secondaryOnly) {
+        mAyaneoSecondaryOnly = secondaryOnly;
+        if (applyAyaneoSecondaryOnlyLocked()) {
+            updateLogicalDisplaysLocked();
+        }
