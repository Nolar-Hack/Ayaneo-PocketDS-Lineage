+    private boolean applyAyaneoSecondaryOnlyLocked() {
+        final LogicalDisplay defaultDisplay = mLogicalDisplays.get(DEFAULT_DISPLAY);
+        if (defaultDisplay == null) {
+            return false;
+        }
+        final String wanted = mAyaneoSecondaryOnly
+                ? AyaneoDualScreenController.SECONDARY_UNIQUE_ID
+                : AyaneoDualScreenController.MAIN_UNIQUE_ID;
+        boolean changed = false;
+        if (!wanted.equals(getUniqueIdLocked(defaultDisplay))) {
+            LogicalDisplay target = null;
+            for (int i = 0; i < mLogicalDisplays.size(); i++) {
+                if (wanted.equals(getUniqueIdLocked(mLogicalDisplays.valueAt(i)))) {
+                    target = mLogicalDisplays.valueAt(i);
+                }
+            }
+            if (target == null) {
+                Slog.w(TAG, "No logical display yet for " + wanted);
+                return false;
+            }
+            Slog.i(TAG, "Default display moved to " + wanted);
+            target.setEnabledLocked(true);
+            defaultDisplay.swapDisplaysLocked(target);
+            changed = true;
+        }
+        for (int i = 0; i < mLogicalDisplays.size(); i++) {
+            final LogicalDisplay display = mLogicalDisplays.valueAt(i);
+            final DisplayDevice device = display.getPrimaryDisplayDeviceLocked();
+            if (display == defaultDisplay || device == null
+                    || device.getDisplayDeviceInfoLocked().type != Display.TYPE_INTERNAL) {
+                continue;
+            }
+            if (display.isEnabledLocked() == mAyaneoSecondaryOnly) {
+                setEnabledLocked(display, !mAyaneoSecondaryOnly);
+                changed = true;
+            }
+        }
+        return changed;
+    }
+
+    private static String getUniqueIdLocked(LogicalDisplay display) {
+        final DisplayDevice device = display.getPrimaryDisplayDeviceLocked();
+        return device == null ? null : device.getUniqueId();
     }
 
