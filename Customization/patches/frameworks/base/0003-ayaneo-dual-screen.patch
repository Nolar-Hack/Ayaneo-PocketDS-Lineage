+package com.android.server.display;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.Slog;
+
+import com.android.server.LocalServices;
+import com.android.server.policy.WindowManagerPolicy;
+
+import java.io.FileWriter;
+import java.io.IOException;
+import java.util.List;
+
+/**
+ * Screen modes of the Ayaneo Pocket DS (device type AR11), as implemented by the stock Ayaneo
+ * framework. The Ayaneo launcher (AYAHome) selects them through Settings.Global:
+ * <ul>
+ * <li>{@code dual_display_mode} 1: both screens (default).
+ * <li>{@code dual_display_mode} 3: top screen only. The bottom panel is blanked; with
+ *     {@code dual_display_pointer_mode} 1 (mouse) or 2 (touchpad) its touch layer keeps working
+ *     as a mouse driving a pointer on the top screen (the stock framework also has a
+ *     touchpad-gesture variant for 2, in its native input code; both act as a mouse here).
+ * <li>{@code dual_display_mode} 4: bottom screen only. The bottom panel becomes the default
+ *     display and the top panel is turned off.
+ * </ul>
+ * Modes 0 (mirroring) and 2 also exist in the stock framework, but AYAHome never selects them;
+ * they are handled as mode 1. The applied values are mirrored into persist.tc.* properties,
+ * which the stock framework and AYAHome read back.
+ *
+ * The clamshell lid is a Hall effect sensor (ROHM bu52053nvx), not an input switch: the stock
+ * framework reads it in DisplayPowerController as a "proximity" sensor and reports it to
+ * WindowManagerPolicy.notifyLidSwitchChanged; here it is read directly (see registerLidHallSensor).
+ */
+final class AyaneoDualScreenController {
+    private static final String TAG = "AyaneoDualScreen";
+
+    static final String MAIN_UNIQUE_ID = "local:4630946412288502659";
+    static final String SECONDARY_UNIQUE_ID = "local:4630946708815090308";
+
+    private static final String MODE_DUAL = "1";
+    private static final String MODE_MAIN_ONLY = "3";
+    private static final String MODE_SECONDARY_ONLY = "4";
+
+    private static final String SETTING_MODE = "dual_display_mode";
+    private static final String SETTING_POINTER_MODE = "dual_display_pointer_mode";
+    private static final String PROP_MODE = "persist.tc.dual_display_mode";
+    private static final String PROP_POINTER_MODE = "persist.tc.dual_display_pointer_mode";
+
+    // Goodix controller of the bottom screen: event_report turns its reports on and off,
+    // touchpad_mode selects its input device: 1 (default) the touchscreen, 0 the "pad" device,
+    // a mouse (relative motion, buttons, wheel) that moves the pointer of the top screen.
+    private static final String BOTTOM_TOUCH_NODES =
+            "/sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a88000.i2c/i2c-2/2-005d/";
+
+    // Hall effect sensor of the lid: the stock framework names it in config_lidHallSensorType
+    // and config_lidHallSensorFallbackType.
+    private static final String LID_HALL_SENSOR_TYPE = "qti.sensor.hall_effect";
+    private static final int LID_HALL_SENSOR_FALLBACK_TYPE = 33171002;
+    // Same threshold as the proximity sensors: a value under it means near (magnet: lid closed).
+    private static final float LID_NEAR_THRESHOLD = 5.0f;
+
+    private static volatile String sMode = MODE_DUAL;
+
+    interface Callbacks {
+        /**
+         * Called with the display sync root held after a mode change: lays out the logical
+         * displays and returns the runnables that apply the panel power states.
+         */
+        List<Runnable> applyModeLocked(boolean secondaryOnly);
+    }
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final Object mLock;
+    private final Callbacks mCallbacks;
+    private String mAppliedMode = "";
+    private String mAppliedPointerMode = "";
+
+    static boolean isSupported() {
+        return "AR11".equals(SystemProperties.get("ro.product.device.type"));
+    }
+
+    /**
+     * Whether this is the bottom screen. Its brightness is applied at once, without the ramp of
+     * the display power controller: the slider of AYAHome also writes the backlight directly, and
+     * the ramp made the screen lag behind it.
+     */
+    static boolean isSecondaryScreen(String uniqueId) {
+        return isSupported() && SECONDARY_UNIQUE_ID.equals(uniqueId);
+    }
+
+    /** Whether the panel must stay off, whatever the display power controller requests. */
+    static boolean isPanelForcedOff(String uniqueId) {
+        final String mode = sMode;
+        return (MODE_MAIN_ONLY.equals(mode) && SECONDARY_UNIQUE_ID.equals(uniqueId))
+                || (MODE_SECONDARY_ONLY.equals(mode) && MAIN_UNIQUE_ID.equals(uniqueId));
+    }
+
+    AyaneoDualScreenController(Context context, Handler handler, Object lock,
+            Callbacks callbacks) {
+        mContext = context;
+        mHandler = handler;
+        mLock = lock;
+        mCallbacks = callbacks;
+    }
+
+    void systemReady() {
+        final ContentObserver observer = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                apply();
+            }
+        };
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor(SETTING_MODE), false, observer, UserHandle.USER_ALL);
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor(SETTING_POINTER_MODE), false, observer,
+                UserHandle.USER_ALL);
+        mHandler.post(this::apply);
+        registerLidHallSensor();
+    }
+
+    /**
+     * Reports the lid (Hall effect sensor) to the window manager policy, which puts the device to
+     * sleep when it closes (config_lidControlsSleep) and wakes it when it opens. The wake-up
+     * variant of the sensor is used so that opening the lid wakes the device from suspend.
+     */
+    private void registerLidHallSensor() {
+        final SensorManager sensorManager = mContext.getSystemService(SensorManager.class);
+        if (sensorManager == null) {
+            Slog.w(TAG, "No SensorManager: the lid is not monitored");
+            return;
+        }
+        Sensor hall = null;
+        for (Sensor sensor : sensorManager.getSensorList(Sensor.TYPE_ALL)) {
+            if (sensor.isWakeUpSensor() && (LID_HALL_SENSOR_TYPE.equals(sensor.getStringType())
+                    || sensor.getType() == LID_HALL_SENSOR_FALLBACK_TYPE)) {
+                hall = sensor;
+                break;
+            }
+        }
+        if (hall == null) {
+            Slog.w(TAG, "No wake-up Hall effect sensor: the lid is not monitored");
+            return;
+        }
+        final float threshold = Math.min(hall.getMaximumRange(), LID_NEAR_THRESHOLD);
+        final boolean[] lastOpen = new boolean[] {true};
+        final boolean[] known = new boolean[1];
+        sensorManager.registerListener(new SensorEventListener() {
+            @Override
+            public void onSensorChanged(SensorEvent event) {
+                final float value = event.values[0];
+                final boolean open = !(value >= 0 && value < threshold);
+                if (known[0] && open == lastOpen[0]) {
+                    return;
+                }
+                known[0] = true;
+                lastOpen[0] = open;
+                Slog.i(TAG, "Lid " + (open ? "open" : "closed") + " (hall value " + value + ")");
+                deliverLidState(lastOpen);
+            }
+
+            @Override
+            public void onAccuracyChanged(Sensor sensor, int accuracy) {}
+        }, hall, SensorManager.SENSOR_DELAY_NORMAL, mHandler);
+        Slog.i(TAG, "Lid monitored with " + hall.getName());
+    }
+
+    /**
+     * The sensor reports its first value very early in the boot. Passing it to the policy right
+     * away makes it send ACTION_LID_STATE_CHANGED, which the activity manager refuses before the
+     * boot is completed (IllegalStateException in system_server: a boot loop). The state is kept
+     * and handed over once sys.boot_completed is set.
+     */
+    private void deliverLidState(boolean[] lastOpen) {
+        mHandler.removeCallbacksAndMessages(lastOpen);
+        if (!SystemProperties.getBoolean("sys.boot_completed", false)) {
+            mHandler.postDelayed(() -> deliverLidState(lastOpen), lastOpen, 1000);
+            return;
+        }
+        final WindowManagerPolicy policy = LocalServices.getService(WindowManagerPolicy.class);
+        if (policy != null) {
+            policy.notifyLidSwitchChanged(SystemClock.elapsedRealtimeNanos(), lastOpen[0]);
+        }
+    }
+
+    private String read(String setting, String prop) {
+        final String value = Settings.Global.getString(mContext.getContentResolver(), setting);
+        return TextUtils.isEmpty(value) ? SystemProperties.get(prop, "") : value;
+    }
+
+    private static void persist(String prop, String value) {
+        if (!value.equals(SystemProperties.get(prop, ""))) {
+            try {
+                SystemProperties.set(prop, value);
+            } catch (RuntimeException e) {
+                Slog.e(TAG, "Failed to set " + prop + "=" + value, e);
+            }
+        }
+    }
+
+    private void apply() {
+        String mode = read(SETTING_MODE, PROP_MODE);
+        if (!MODE_MAIN_ONLY.equals(mode) && !MODE_SECONDARY_ONLY.equals(mode)) {
+            mode = MODE_DUAL;
+        }
+        String pointerMode = read(SETTING_POINTER_MODE, PROP_POINTER_MODE);
+        if (!"1".equals(pointerMode) && !"2".equals(pointerMode)) {
+            pointerMode = "0";
+        }
+        if (mode.equals(mAppliedMode) && pointerMode.equals(mAppliedPointerMode)) {
+            return;
+        }
+        Slog.i(TAG, "dual_display_mode " + mAppliedMode + " -> " + mode
+                + ", pointer mode " + mAppliedPointerMode + " -> " + pointerMode);
+        persist(PROP_MODE, mode);
+        persist(PROP_POINTER_MODE, pointerMode);
+
+        final List<Runnable> panelUpdates;
+        synchronized (mLock) {
+            sMode = mode;
+            panelUpdates = mCallbacks.applyModeLocked(MODE_SECONDARY_ONLY.equals(mode));
+        }
+        for (Runnable update : panelUpdates) {
+            update.run();
+        }
+
+        // The bottom touch layer only reports while the bottom screen is in use: shown, or
+        // driving the pointer of the top screen (top screen only + pointer mode).
+        final boolean bottomPointer = MODE_MAIN_ONLY.equals(mode) && !"0".equals(pointerMode);
+        writeNode(BOTTOM_TOUCH_NODES + "touchpad_mode", bottomPointer ? "0" : "1");
+        writeNode(BOTTOM_TOUCH_NODES + "event_report",
+                !MODE_MAIN_ONLY.equals(mode) || bottomPointer ? "1" : "0");
+
+        mAppliedMode = mode;
+        mAppliedPointerMode = pointerMode;
+    }
+
+    private static void writeNode(String path, String value) {
+        try (FileWriter writer = new FileWriter(path)) {
+            writer.write(value);
+        } catch (IOException e) {
+            Slog.w(TAG, "Failed to write " + value + " to " + path, e);
+        }
+    }
+}
