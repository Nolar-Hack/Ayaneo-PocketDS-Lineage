+    }
+
+    private static boolean isAyaneoSecondaryScreen(DisplayContent dc) {
+        return AYANEO_SECONDARY_UNIQUE_ID.equals(dc.getDisplayInfo().uniqueId);
+    }
+
+    @Nullable
+    private DisplayContent getLockedFocusDisplay() {
+        if (TextUtils.isEmpty(mLockedFocusDisplay) || "none".equals(mLockedFocusDisplay)) {
+            return null;
+        }
+        final int displayId;
+        try {
+            displayId = Integer.parseInt(mLockedFocusDisplay);
+        } catch (NumberFormatException e) {
+            return null;
+        }
+        final DisplayContent dc = getDisplayContent(displayId);
+        if (dc != null) {
+            return dc;
+        }
+        // The locked display is gone (screen mode change): fall back to the bottom screen.
+        for (int i = mChildren.size() - 1; i >= 0; --i) {
+            final DisplayContent child = mChildren.get(i);
+            if (AYANEO_SECONDARY_UNIQUE_ID.equals(child.getDisplayInfo().uniqueId)) {
+                return child;
+            }
+        }
+        return null;
+    }
