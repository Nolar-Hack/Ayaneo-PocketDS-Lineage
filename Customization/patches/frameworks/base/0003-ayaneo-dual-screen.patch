+    // Ayaneo Pocket DS screen mode change: moves the default display, then re-applies the panel
+    // power states (a panel hidden by the mode is kept off by LocalDisplayDevice).
+    private List<Runnable> applyAyaneoDualScreenModeLocked(boolean secondaryOnly) {
+        mLogicalDisplayMapper.setAyaneoSecondaryOnlyLocked(secondaryOnly);
+        final List<Runnable> panelUpdates = new ArrayList<>();
+        mDisplayDeviceRepo.forEachLocked((DisplayDevice device) -> {
+            final Runnable update;
+            if (AyaneoDualScreenController.isPanelForcedOff(device.getUniqueId())) {
+                update = device.requestDisplayStateLocked(Display.STATE_OFF,
+                        PowerManager.BRIGHTNESS_OFF_FLOAT, PowerManager.BRIGHTNESS_OFF_FLOAT,
+                        null);
+            } else {
+                update = updateDisplayStateLocked(device);
+            }
+            if (update != null) {
+                panelUpdates.add(update);
+            }
+        });
+        // A display enabled again by the mode change has a new power controller that the
+        // power manager only updates on its next state change: until then the panel stays
+        // off. Send it the current request of its group right away.
+        for (int i = 0; i < mAyaneoLastPowerRequests.size(); i++) {
+            final DisplayGroup group =
+                    mLogicalDisplayMapper.getDisplayGroupLocked(mAyaneoLastPowerRequests.keyAt(i));
+            if (group == null) {
+                continue;
+            }
+            for (int j = 0; j < group.getSizeLocked(); j++) {
+                final DisplayPowerController dpc =
+                        mDisplayPowerControllers.get(group.getIdLocked(j));
+                if (dpc != null) {
+                    dpc.requestPowerState(mAyaneoLastPowerRequests.valueAt(i),
+                            false /* waitForNegativeProximity */);
+                }
+            }
+        }
+        scheduleTraversalLocked(false);
+        return panelUpdates;
+    }
