+    void onLockedFocusDisplayChanged(boolean updateFocus) {
+        String value = Settings.Global.getString(mWmService.mContext.getContentResolver(),
+                AYANEO_LOCKED_FOCUS_SETTING);
+        if (TextUtils.isEmpty(value)) {
+            value = SystemProperties.get(AYANEO_LOCKED_FOCUS_PROP, "");
+        } else if (!value.equals(SystemProperties.get(AYANEO_LOCKED_FOCUS_PROP, ""))) {
+            try {
+                SystemProperties.set(AYANEO_LOCKED_FOCUS_PROP, value);
+            } catch (RuntimeException e) {
+                Slog.e(TAG, "Failed to set " + AYANEO_LOCKED_FOCUS_PROP + "=" + value, e);
+            }
+        }
+        synchronized (mService.mGlobalLock) {
+            mLockedFocusDisplay = value.trim();
+            Slog.d(TAG, "locked_focus_display_id=" + mLockedFocusDisplay);
+            if (updateFocus) {
+                mWmService.updateFocusedWindowLocked(UPDATE_FOCUS_NORMAL,
+                        true /* updateInputWindows */);
+            }
