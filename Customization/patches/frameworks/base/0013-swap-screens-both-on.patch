@@ -143,6 +148,8 @@ final class AyaneoDualScreenController {
         mContext.getContentResolver().registerContentObserver(
                 Settings.Global.getUriFor(SETTING_POINTER_MODE), false, observer,
                 UserHandle.USER_ALL);
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor(SETTING_SWAP), false, observer, UserHandle.USER_ALL);
         mHandler.post(this::apply);
         registerLidHallSensor();
     }
@@ -235,18 +242,23 @@ final class AyaneoDualScreenController {
         if (!"1".equals(pointerMode) && !"2".equals(pointerMode)) {
             pointerMode = "0";
         }
-        if (mode.equals(mAppliedMode) && pointerMode.equals(mAppliedPointerMode)) {
+        // Swapping the screens only makes sense while both are used.
+        final boolean swapped = MODE_DUAL.equals(mode)
+                && Settings.Global.getInt(mContext.getContentResolver(), SETTING_SWAP, 0) == 1;
+        if (mode.equals(mAppliedMode) && pointerMode.equals(mAppliedPointerMode)
+                && swapped == mAppliedSwap) {
             return;
         }
         Slog.i(TAG, "dual_display_mode " + mAppliedMode + " -> " + mode
-                + ", pointer mode " + mAppliedPointerMode + " -> " + pointerMode);
+                + ", pointer mode " + mAppliedPointerMode + " -> " + pointerMode
+                + ", swapped " + mAppliedSwap + " -> " + swapped);
         persist(PROP_MODE, mode);
         persist(PROP_POINTER_MODE, pointerMode);
 
         final List<Runnable> panelUpdates;
         synchronized (mLock) {
             sMode = mode;
-            panelUpdates = mCallbacks.applyModeLocked(MODE_SECONDARY_ONLY.equals(mode));
+            panelUpdates = mCallbacks.applyModeLocked(MODE_SECONDARY_ONLY.equals(mode), swapped);
         }
         for (Runnable update : panelUpdates) {
             update.run();
@@ -261,6 +273,7 @@ final class AyaneoDualScreenController {
 
         mAppliedMode = mode;
         mAppliedPointerMode = pointerMode;
+        mAppliedSwap = swapped;
     }
 
