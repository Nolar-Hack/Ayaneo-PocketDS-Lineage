Subject: [PATCH] AudioTrack: fail writes from an unmapped direct buffer

A direct ByteBuffer can wrap memory that was already released, e.g. the output
buffer of a released MediaCodec that a media player still writes. ExoPlayer 2.19
(AYAHome profile animations, Opus in WebM) does this after an audio codec error:
copying from it crashed the app (SIGSEGV in AudioTrack::write). Check that the
source range is mapped (mincore) and fail the write with ERROR_BAD_VALUE instead,
which the player handles.

diff --git a/core/jni/android_media_AudioTrack.cpp b/core/jni/android_media_AudioTrack.cpp
--- a/core/jni/android_media_AudioTrack.cpp
+++ b/core/jni/android_media_AudioTrack.cpp
@@ -35,7 +35,11 @@
 #include <nativehelper/ScopedUtfChars.h>
 #include <utils/Log.h>
 
+#include <algorithm>
 #include <cinttypes>
+#include <errno.h>
+#include <sys/mman.h>
+#include <unistd.h>
 
 #include "android_media_AudioAttributes.h"
 #include "android_media_AudioErrors.h"
@@ -769,6 +773,26 @@ static jint android_media_AudioTrack_writeArray(JNIEnv *env, jobject thiz,
 }
 
 // ----------------------------------------------------------------------------
+// Whether [addr, addr + size) is still mapped in this process. A direct ByteBuffer may
+// wrap memory that was already released, e.g. the output buffer of a released MediaCodec
+// that a media player still writes (ExoPlayer 2.19 after an audio codec error): copying
+// from it would crash the app instead of failing the write.
+static bool isRangeMapped(const void* addr, size_t size) {
+    if (size == 0) return true;
+    static const uintptr_t pageSize = static_cast<uintptr_t>(sysconf(_SC_PAGESIZE));
+    uintptr_t start = reinterpret_cast<uintptr_t>(addr) & ~(pageSize - 1);
+    const uintptr_t end = reinterpret_cast<uintptr_t>(addr) + size;
+    unsigned char residency[64];
+    while (start < end) {
+        const size_t len = std::min<uintptr_t>(end - start, pageSize * sizeof(residency));
+        if (mincore(reinterpret_cast<void*>(start), len, residency) != 0 && errno == ENOMEM) {
+            return false;
+        }
+        start += len;
+    }
+    return true;
+}
+
 static jint android_media_AudioTrack_write_native_bytes(JNIEnv *env,  jobject thiz,
         jobject javaByteBuffer, jint byteOffset, jint sizeInBytes,
         jint javaAudioFormat, jboolean isWriteBlocking) {
@@ -787,6 +811,10 @@ static jint android_media_AudioTrack_write_native_bytes(JNIEnv *env,  jobject th
         ALOGE("Error retrieving source of audio data to play, can't play");
         return (jint)AUDIO_JAVA_BAD_VALUE;
     }
+    if (byteOffset < 0 || sizeInBytes < 0 || !isRangeMapped(bytes + byteOffset, sizeInBytes)) {
+        ALOGE("Source of audio data to play is not mapped (released buffer?), can't play");
+        return (jint)AUDIO_JAVA_BAD_VALUE;
+    }
 
     jint written = writeToTrack(lpTrack, javaAudioFormat, bytes, byteOffset,
             sizeInBytes, isWriteBlocking == JNI_TRUE /* blocking */);
