type hal_tsnv_default, domain;
hal_server_domain(hal_tsnv_default, hal_tsnv)

type hal_tsnv_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_tsnv_default)

hal_attribute_hwservice(hal_tsnv, hal_tsnv_hwservice)
hwbinder_use(hal_tsnv_default)
get_prop(hal_tsnv_default, hwservicemanager_prop)
allow hal_tsnv_default hidl_memory_hwservice:hwservice_manager find;

allow hal_tsnv_default tsnv_device:chr_file { ioctl read open };
