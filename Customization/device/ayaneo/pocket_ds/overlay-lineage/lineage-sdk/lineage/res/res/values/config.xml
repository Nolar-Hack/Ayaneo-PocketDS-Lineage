<resources>
    <!-- Hardware keys present: Home (the Ayaneo button, mapped to HOME in gpio-keys.kl) -->
    <integer name="config_deviceHardwareKeys">1</integer>
    <integer name="config_deviceHardwareWakeKeys">0</integer>
    <!-- The RGB LED next to the USB-C port (PMIC tri-LED): notifications in colour, blinking,
         adjustable brightness (1 + 8 + 32). Not the battery flags: PocketDS Extra shows the
         battery level on it (LedController). -->
    <integer name="config_deviceLightCapabilities">41</integer>
</resources>
