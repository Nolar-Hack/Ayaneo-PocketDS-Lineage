# Main screen touch (FocalTech, 1080x1920 portrait panel). The display is turned
# to landscape by ro.surface_flinger.primary_display_orientation=ORIENTATION_270:
# rotate the touch the same way and keep it on the main display.
touch.deviceType = touchScreen
touch.orientationAware = 1
touch.orientation = ORIENTATION_270
touch.displayId = local:4630946412288502659
