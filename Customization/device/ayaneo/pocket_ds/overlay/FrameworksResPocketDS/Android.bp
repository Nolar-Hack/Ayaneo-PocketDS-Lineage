// In system_ext, not vendor: static overlays are ordered by partition first, and the
// LineageOS defaults (desktop windowing on tablets...) come as an RRO on product,
// which would otherwise override this one.
runtime_resource_overlay {
    name: "FrameworksResPocketDS",
    system_ext_specific: true,
}
