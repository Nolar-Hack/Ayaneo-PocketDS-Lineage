# See pocketds-firstboot.sh
# TODO(enforcing): own SELinux domain (needs pm / cmd role as system).
service pocketds_firstboot /system/bin/sh /system_ext/bin/pocketds-firstboot.sh
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start pocketds_firstboot
