# See pocketds-cpugov.sh
# TODO(enforcing): own SELinux domain (cpufreq sysfs, inotify on media_rw files).
service pocketds_cpugov /system/bin/sh /system_ext/bin/pocketds-cpugov.sh
    user root
    group root media_rw
    disabled
    oneshot
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start pocketds_cpugov
