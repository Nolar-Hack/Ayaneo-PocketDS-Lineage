//
// PocketDS Extra: what the stock Ayaneo framework did for the Pocket DS hardware
// (second screen brightness, keyboard on the second screen, touch tuning).

android_app {
    name: "PocketDSParts",
    // The performance service of Qualcomm (hints sent as the stock framework did), by HIDL.
    static_libs: ["vendor.qti.hardware.perf-V2.0-java"],
    srcs: ["src/**/*.java"],
    asset_dirs: ["assets"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-pocketds-parts.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-pocketds-parts.xml",
    src: "permissions/privapp-permissions-pocketds-parts.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
